# Copy to `.env` and fill in. Never commit the real `.env`.
# ── Environment selection: dev | qa | uat ─────────────────────────
TEST_ENV=qa

# ── Reporting: allure | html | both ───────────────────────────────
REPORT_TYPE=allure

# ── Browser ───────────────────────────────────────────────────────
BROWSER=chromium
HEADLESS=true

# ── DB credentials (override per environment) ─────────────────────
DB_USER=
DB_PASSWORD=

# ── Jira integration ──────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Azure DevOps (ADO) integration ────────────────────────────────
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=
ADO_PAT=

# ── Prompt layer (LLM-assisted test-case sync / generation) ───────
ANTHROPIC_API_KEY=
PROMPT_MODEL=claude-opus-4-8
