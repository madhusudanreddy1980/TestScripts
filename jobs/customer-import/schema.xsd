<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:example:batch:customer:v1"
           xmlns="urn:example:batch:customer:v1"
           elementFormDefault="qualified">

  <xs:simpleType name="CustomerId">
    <xs:restriction base="xs:string"><xs:pattern value="(C\d{6}|SYN-[0-9a-f]{6}-\d{4})"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Name">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="50"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Email">
    <xs:restriction base="xs:string"><xs:maxLength value="120"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Country">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Za-z]{2}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Money">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2"/>
      <xs:maxInclusive value="9999999.99"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="CustomerType">
    <xs:sequence>
      <xs:element name="BatchRef" type="xs:string"/>
      <xs:element name="FirstName" type="Name"/>
      <xs:element name="LastName" type="Name"/>
      <xs:element name="Email" type="Email"/>
      <xs:element name="DateOfBirth" type="xs:date"/>
      <xs:element name="Country" type="Country"/>
      <xs:element name="CreditLimit" type="Money"/>
    </xs:sequence>
    <xs:attribute name="customerId" type="CustomerId" use="required"/>
  </xs:complexType>

  <xs:element name="CustomerBatch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Customer" type="CustomerType" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="1.0"/>
      <xs:attribute name="runId" type="xs:string" use="required"/>
      <xs:attribute name="recordCount" type="xs:nonNegativeInteger" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
