{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:batch:payment:v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchHeader", "payments"],
  "properties": {
    "batchHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "runId", "schemaVersion", "recordCount"],
      "properties": {
        "jobId": {"const": "payment-import"},
        "runId": {"type": "string", "minLength": 1},
        "schemaVersion": {"const": "2.1"},
        "recordCount": {"type": "integer", "minimum": 0}
      }
    },
    "payments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paymentRef", "correlationId", "debitAccount", "amount", "currency", "valueDate"],
        "properties": {
          "paymentRef": {"type": "string", "pattern": "^(PAY\\d{8}|SYN-[0-9a-f]{6}-\\d{4})$"},
          "correlationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "debitAccount": {"type": "string", "pattern": "^\\d{12}$"},
          "amount": {"type": "number", "maximum": 99999999.99},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "valueDate": {"type": "string", "format": "date"},
          "narrative": {"type": ["string", "null"], "maxLength": 140}
        }
      }
    }
  }
}
